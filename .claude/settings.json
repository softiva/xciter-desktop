{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "alwaysThinkingEnabled": true,
  "hooks": {},
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(yarn *)",
      "Bash(pnpm *)",
      "Bash(bun *)",
      "Bash(git *)",
      "Bash(npx *)",
      "Read(src/**)",
      "Read(package.json)",
      "Read(tsconfig.json)",
      "Read(CLAUDE.md)",
      "Read(.claude/**)",
      "Write(src/**)",
      "Write(.claude/**)",
      "Bash(cargo check *)",
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo nextest *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo doc *)",
      "Read(Cargo.toml)",
      "Read(Cargo.lock)",
      "Read(rust-toolchain.toml)",
      "Read(tests/**)",
      "Read(benches/**)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(secrets/**)",
      "Bash(rm *)",
      "Bash(sudo *)",
      "Bash(cargo login *)",
      "Bash(cargo owner *)",
      "Bash(cargo yank *)"
    ],
    "ask": [
      "Write(package.json)",
      "Write(.gitignore)",
      "Write(.env.example)",
      "Write(Cargo.toml)",
      "Bash(cargo add *)",
      "Bash(cargo install *)",
      "Bash(cargo publish *)"
    ]
  }
}