{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xciter",
  "version": "0.2.0",
  "identifier": "com.softiva.xciter.player",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Xciter",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "copyright": "Softiva",
    "publisher": "Softiva",
    "homepage": "https://softiva.app/xciter",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "shortDescription": "Music player with an exciter, virtual bass and 31-band equalizer",
    "longDescription": "Xciter plays the music you own and makes it sound better: an exciter, virtual bass, a Crystalizer, Even out and a 31-band equalizer. No account; your music and settings stay on your computer.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libasound2 | libasound2t64"
        ],
        "section": "sound"
      },
      "rpm": {
        "depends": [
          "alsa-lib"
        ]
      }
    }
  }
}
